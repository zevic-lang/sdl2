module Main

import Sdl2
import Sdl2.Mixer as Mixer
import Zevic.Console

// 1, 2, 3 play C, E and G. M starts and stops a looping arpeggio. Up and Down change the volume.
// Run from this folder. Escape quits.
fn Main() {
    Sdl2.Init().Unwrap()
    defer Sdl2.Quit()
    match (Mixer.Init()) {
        Ok(_) => {},
        Err(e) => {
            Console.Println("${e.Message()}")
            return
        },
    }
    defer Mixer.Quit()

    let win: Sdl2.Window = Sdl2.Window.Open("mixer", 480, 200).Unwrap()
    defer win.Close()
    let ren: Sdl2.Renderer = win.Renderer().Unwrap()
    defer ren.Close()
    let pump: Sdl2.EventPump = Sdl2.EventPump.New()
    defer pump.Close()

    let c4: Mixer.Sound = Mixer.Sound.Load("assets/c4.wav").Unwrap()
    defer c4.Close()
    let e4: Mixer.Sound = Mixer.Sound.Load("assets/e4.wav").Unwrap()
    defer e4.Close()
    let g4: Mixer.Sound = Mixer.Sound.Load("assets/g4.wav").Unwrap()
    defer g4.Close()
    let music: Mixer.Music = Mixer.Music.Load("assets/arpeggio.wav").Unwrap()
    defer music.Close()

    Console.Println("SDL2_mixer ${Mixer.Version()}")
    mut volume: I32 = 96
    Mixer.MusicVolume(volume)
    Mixer.Volume(Mixer.AllChannels, volume)
    mut running: Bool = true
    while (running) {
        while (true) {
            match (pump.Poll()) {
                Some(ev) => match (ev) {
                    Sdl2.Event.Quit => { running = false },
                    Sdl2.Event.KeyDown(key, _) => {
                        if (key == Sdl2.KeyEscape) { running = false }
                        if (key == 49) { c4.Play().Unwrap() }
                        if (key == 50) { e4.Play().Unwrap() }
                        if (key == 51) { g4.Play().Unwrap() }
                        if (key == 109) {
                            if (Mixer.MusicPlaying()) { Mixer.StopMusic() } else { music.Loop().Unwrap() }
                        }
                        if (key == Sdl2.KeyUp && volume < Mixer.MaxVolume) { volume += 16 }
                        if (key == Sdl2.KeyDown && volume > 0) { volume -= 16 }
                        Mixer.MusicVolume(volume)
                        Mixer.Volume(Mixer.AllChannels, volume)
                    },
                    _ => {},
                },
                None => break,
            }
        }
        ren.Color(24, 28, 48, 255)
        ren.Clear()
        ren.Color(255, 255, 255, 255)
        ren.Text(16, 16, "1 2 3: notes   M: music   Up/Down: volume", 1)
        ren.Color(255, 200, 0, 255)
        ren.Text(16, 60, "volume ${volume} / ${Mixer.MaxVolume}", 2)
        ren.Color(120, 200, 255, 255)
        ren.Text(16, 110, if (Mixer.MusicPlaying()) { "music: playing" } else { "music: stopped" }, 2)
        ren.Present()
        Sdl2.Delay(10)
    }
}
