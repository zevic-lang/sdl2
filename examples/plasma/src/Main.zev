module Main

import Sdl2
import Zevic.Math

// A classic plasma: every pixel of a small picture is a sum of waves, coloured through a palette and scaled up
// to the window. Space switches the palette, Escape quits.

fn rgb(r: I32, g: I32, b: I32) -> U32 {
    0xFF000000_U32 | (r.ToU32Wrap() << 16) | (g.ToU32Wrap() << 8) | b.ToU32Wrap()
}

fn clamp255(v: I32) -> I32 {
    if (v < 0) { return 0 }
    if (v > 255) { return 255 }
    v
}

// 256 colours; kind 0 runs through the rainbow, kind 1 is fire
fn palette(kind: I32) -> Array<U32> {
    mut p: Array<U32> = []
    mut i: I32 = 0
    while (i < 256) {
        let a: F64 = i.ToF64() * 6.2831853 / 256.0
        if (kind == 0) {
            p.Push(rgb((128.0 + 127.0 * Math.Sin(a)).ToI32(), (128.0 + 127.0 * Math.Sin(a + 2.094)).ToI32(), (128.0 + 127.0 * Math.Sin(a + 4.188)).ToI32()))
        } else {
            p.Push(rgb(clamp255(i * 3), clamp255(i * 3 - 256), clamp255(i * 3 - 512)))
        }
        i += 1
    }
    p
}

fn Main() {
    let w: I32 = 160
    let h: I32 = 90
    Sdl2.Init().Unwrap()
    defer Sdl2.Quit()
    let win: Sdl2.Window = Sdl2.Window.Open("plasma", 640, 360).Unwrap()
    defer win.Close()
    let ren: Sdl2.Renderer = win.Renderer().Unwrap()
    defer ren.Close()
    let fb: Sdl2.Framebuffer = ren.Framebuffer(w, h).Unwrap()
    defer fb.Close()
    let pump: Sdl2.EventPump = Sdl2.EventPump.New()
    defer pump.Close()

    let rainbow: Array<U32> = palette(0)
    let fire: Array<U32> = palette(1)
    mut use_fire: Bool = false
    mut px: Array<U32> = []
    mut n: I32 = 0
    while (n < w * h) {
        px.Push(0xFF000000_U32)
        n += 1
    }

    mut clock: Sdl2.Clock = Sdl2.Clock.New(60)
    mut t: F64 = 0.0
    mut frame: I32 = 0
    mut fps: I32 = 0
    mut running: Bool = true
    while (running) {
        while (true) {
            match (pump.Poll()) {
                Some(ev) => match (ev) {
                    Sdl2.Event.Quit => { running = false },
                    Sdl2.Event.KeyDown(key, _) => {
                        if (key == Sdl2.KeyEscape) { running = false }
                        if (key == Sdl2.KeySpace) { use_fire = !use_fire }
                    },
                    _ => {},
                },
                None => break,
            }
        }

        let pal: Array<U32> = if (use_fire) { fire } else { rainbow }
        mut y: I32 = 0
        while (y < h) {
            mut x: I32 = 0
            while (x < w) {
                let dx: F64 = (x - w / 2).ToF64()
                let dy: F64 = (y - h / 2).ToF64()
                let v1: F64 = Math.Sin(x.ToF64() * 0.08 + t) + Math.Sin(y.ToF64() * 0.11 - t * 1.3)
                let v2: F64 = Math.Sin((x + y).ToF64() * 0.05 + t * 0.7)
                let v3: F64 = Math.Sin(Math.Sqrt(dx * dx + dy * dy) * 0.12 - t * 2.0)
                let v: F64 = v1 + v2 + v3
                // v is between -4 and 4
                let idx: I32 = ((v + 4.0) * 31.99).ToI32()
                px[(y * w + x).ToI64()] = pal[idx.ToI64()]
                x += 1
            }
            y += 1
        }
        fb.Draw(px)

        ren.Color(255, 255, 255, 255)
        ren.Text(8, 8, "${fps} fps   Space: palette   Escape: quit", 1)
        if (Sdl2.SmokeDone(ren, frame)) { break }
        ren.Present()
        let dt: F64 = clock.Tick()
        t += dt
        fps = (1.0 / dt).ToI32()
        frame += 1
    }
}
